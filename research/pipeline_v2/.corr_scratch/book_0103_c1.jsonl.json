  {"claim_ref": "book_0103::lead_book_0103_1_090", "verdict": "corroboration", "behavior_id": "volume_confirmed_breakout", "page": 1, "exact_text": "The bullish\nbreakout is signaled by a decisive closing above the flat upper\ntrendline. As in the case of all valid upside breakouts, volume\nshould see a noticeable increase on the breakout.", "added_conditions": ["a return move back to the support line (the flat upper line) is not unusual and should take place on light volume"], "added_parameters": []},
