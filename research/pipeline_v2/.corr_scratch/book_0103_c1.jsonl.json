  {"claim_ref": "book_0103::lead_book_0103_1_065", "verdict": "generic", "behavior_id": null, "page": null, "exact_text": null, "added_conditions": [], "added_parameters": []},
  {"claim_ref": "book_0103::lead_book_0103_2_078", "verdict": "generic", "behavior_id": null, "page": null, "exact_text": null, "added_conditions": [], "added_parameters": []},
  {"claim_ref": "book_0103::lead_book_0103_1_068", "verdict": "corroboration", "behavior_id": "breakout_retest", "page": 1, "exact_text": "Usually a return move develops which is a bounce back to the bot-\ntom of the neckline or to the previous reaction low at point D (see\npoint G), both of which have now become overhead resistance.", "added_conditions": ["if the initial breaking of the neckline is on very heavy trading, the odds for a return move are diminished", "the return move should be on light volume and be followed by resumption of the new downtrend"], "added_parameters": []},
  {"claim_ref": "book_0103::lead_book_0103_1_069", "verdict": "generic", "behavior_id": null, "page": null, "exact_text": null, "added_conditions": [], "added_parameters": []},
  {"claim_ref": "book_0103::lead_book_0103_1_072", "verdict": "corroboration", "behavior_id": "volume_confirmed_breakout", "page": 1, "exact_text": "The critical point\noccurs at the rally through the neckline. This signal must be\naccompanied by a sharp burst of trading volume if the breakout\nis for real.", "added_conditions": ["volume at the head is lighter than at the left shoulder", "the rally from the head should show an increase in trading activity, often exceeding the volume on the rally from the left shoulder", "the dip to the right shoulder should be on very light volume"], "added_parameters": []},
  {"claim_ref": "book_0103::lead_book_0103_1_073", "verdict": "generic", "behavior_id": null, "page": null, "exact_text": null, "added_conditions": [], "added_parameters": []},
  {"claim_ref": "book_0103::lead_book_0103_1_074", "verdict": "corroboration", "behavior_id": "pattern_breakout_projection", "page": 1, "exact_text": "Prices will\nusually move a minimum distance from the breakout point at\nleast equal to the height of the pattern.", "added_conditions": ["once the breakout occurs, a return move to the breakout point is not unusual"], "added_parameters": []},
