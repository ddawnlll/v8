  {"claim_ref": "18", "verdict": "corroboration", "behavior_id": "support_resistance_bounce", "page": null, "exact_text": "As the market rallies toward resistance, the bulls will incur a tremendous amount of resistance at or near the highs.", "added_conditions": [], "added_parameters": []},
  {"claim_ref": "19", "verdict": "corroboration", "behavior_id": "candlestick_reversal_pattern", "page": null, "exact_text": "look for confirming bearish Japanese candlestick formations near the highs, and then short the market after the bearish formation appears", "added_conditions": [], "added_parameters": []},
  {"claim_ref": "20", "verdict": "corroboration", "behavior_id": "candlestick_reversal_pattern", "page": null, "exact_text": "The bearish candlestick formation gives confirmation that the market is about to U-turn.", "added_conditions": [], "added_parameters": []},
  {"claim_ref": "21", "verdict": "corroboration", "behavior_id": "support_resistance_bounce", "page": null, "exact_text": "As prices begin to fall and get closer to the level of support, once again major banks and financial institutions will enter the market, and there will be a change of the tide from bearish to bullish", "added_conditions": [], "added_parameters": []},
  {"claim_ref": "22", "verdict": "generic", "behavior_id": null, "page": null, "exact_text": null, "added_conditions": [], "added_parameters": []},
  {"claim_ref": "23", "verdict": "corroboration", "behavior_id": "candlestick_reversal_pattern", "page": null, "exact_text": "look for bullish Japanese candlestick formations near a level of support or a prominent low. They will enter going long after the bullish formation appears.", "added_conditions": [], "added_parameters": []},
  {"claim_ref": "24", "verdict": "corroboration", "behavior_id": "candlestick_reversal_pattern", "page": null, "exact_text": "The bullish candlestick formation gives confirmation that the market is about to U-turn.", "added_conditions": [], "added_parameters": []},
