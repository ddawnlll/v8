  {"claim_ref": "27", "verdict": "corroboration", "behavior_id": "volatility_breakout", "page": null, "exact_text": "This strategy is called a straddle and was designed for trading in tight trading ranges in anticipation of a fundamental announcement.", "added_conditions": [], "added_parameters": []},
  {"claim_ref": "28", "verdict": "corroboration", "behavior_id": "volatility_breakout", "page": null, "exact_text": "the longer the market has been in the range, the more aggressive the outbreak will be.", "added_conditions": [], "added_parameters": []},
  {"claim_ref": "29", "verdict": "corroboration", "behavior_id": "volatility_breakout", "page": null, "exact_text": "Place your straddle orders five minutes before the announcement is made. Place a buy order 15 pips above or north of the resistance level and 10 pips below or south of the level of support, or the trading range.", "added_conditions": [], "added_parameters": [{"name": "buy order distance above resistance", "value": "15 pips", "page": null}, {"name": "sell order distance below support", "value": "10 pips", "page": null}]},
