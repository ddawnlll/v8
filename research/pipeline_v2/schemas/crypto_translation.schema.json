{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Crypto/V8 Translation",
  "description": "research_pipeline_v2.0 crypto_translator output. Every change from source to target is provenance-tagged; nothing silent.",
  "type": "object",
  "required": ["translation_id", "source_strategy_id", "target_market", "field_mappings", "preserved_source_logic", "transfer_risks", "required_data", "translation_confidence"],
  "properties": {
    "translation_id": { "type": "string" },
    "source_strategy_id": { "type": "string" },
    "target_market": {
      "type": "object",
      "required": ["instrument_type", "timeframe", "session_model"],
      "properties": {
        "instrument_type": { "enum": ["USDM_PERPETUAL","COIN_M_PERPETUAL","SPOT"] },
        "timeframe": { "type": "string" },
        "session_model": { "enum": ["24_7"] }
      }
    },
    "field_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "source_value", "target_value", "provenance"],
        "properties": {
          "field": { "type": "string" },
          "source_value": { "type": ["string", "null"] },
          "target_value": { "type": ["string", "null"] },
          "parameter_range": { "type": "array", "items": { "type": "number" } },
          "reason": { "type": "string" },
          "provenance": { "enum": ["SOURCE_EXPLICIT","SOURCE_DERIVED","MARKET_TRANSLATION","V8_OPERATIONALIZATION","EXPERIMENTAL_ASSUMPTION","V8_DEFAULT","UNRESOLVED"] }
        }
      }
    },
    "preserved_source_logic": { "type": "array", "items": { "type": "string" } },
    "unsupported_elements": { "type": "array", "items": { "type": "string" } },
    "transfer_risks": { "type": "array", "items": { "type": "string" } },
    "required_data": { "type": "array", "items": { "type": "string" } },
    "data_status": { "enum": ["AVAILABLE","PARTIAL","DATA_BLOCKED"] },
    "translation_confidence": { "enum": ["HIGH","MEDIUM","LOW"] }
  },
  "additionalProperties": false
}
