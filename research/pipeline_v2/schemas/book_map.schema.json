{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Book Map",
  "description": "research_pipeline_v2.0 book_mapper output. Structure only; no strategy extraction.",
  "type": "object",
  "required": ["book_id", "chapters", "coverage", "total_parts", "mapped_parts"],
  "properties": {
    "book_id": { "type": "string" },
    "title": { "type": "string" },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter_id", "title", "part_range", "page_range"],
        "properties": {
          "chapter_id": { "type": "string" },
          "title": { "type": "string" },
          "part_range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "page_range": { "type": ["array", "null"], "items": { "type": "integer" } },
          "relevance": {
            "type": "object",
            "properties": {
              "strategy_rules": { "enum": ["high", "medium", "low"] },
              "methodology": { "enum": ["high", "medium", "low"] },
              "risk_rules": { "enum": ["high", "medium", "low"] }
            }
          }
        }
      }
    },
    "front_matter_parts": { "type": "array", "items": { "type": "integer" } },
    "back_matter_parts": { "type": "array", "items": { "type": "integer" } },
    "glossary_parts": { "type": "array", "items": { "type": "integer" } },
    "index_parts": { "type": "array", "items": { "type": "integer" } },
    "bibliography_parts": { "type": "array", "items": { "type": "integer" } },
    "chart_heavy_parts": { "type": "array", "items": { "type": "integer" } },
    "empirical_result_parts": { "type": "array", "items": { "type": "integer" } },
    "part_content_types": {
      "type": "object",
      "description": "part_id -> list of content type tags",
      "additionalProperties": { "type": "array", "items": { "enum": ["strategy_rules","risk_management","methodology","empirical_results","examples","narrative","front_matter","index","glossary","bibliography"] } }
    },
    "total_parts": { "type": "integer" },
    "mapped_parts": { "type": "integer" },
    "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "missing_parts": { "type": "array", "items": { "type": "integer" } }
  },
  "additionalProperties": false
}
