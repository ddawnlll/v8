{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skeptic Audit",
  "description": "research_pipeline_v2.0 skeptic_auditor output. Searches the whole book for counterevidence; finding none is recorded as NOT_FOUND_IN_SOURCE.",
  "type": "object",
  "required": ["raw_claim_ids", "author_caveats", "failure_examples", "contradictions", "invented_fields_detected", "executable_assessment"],
  "properties": {
    "raw_claim_ids": { "type": "array", "items": { "type": "string" } },
    "author_caveats": { "type": "array", "items": { "type": "object", "properties": { "page": { "type": ["integer", "null"] }, "exact_text": { "type": "string" }, "meaning": { "type": "string" } } } },
    "failure_examples": { "type": "array", "items": { "type": "object", "properties": { "page": { "type": ["integer", "null"] }, "summary": { "type": "string" } } } },
    "contradictions": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string" }, "first_passage": { "type": "object", "properties": { "page": { "type": ["integer", "null"] }, "interpretation": { "type": "string" } } }, "second_passage": { "type": "object", "properties": { "page": { "type": ["integer", "null"] }, "interpretation": { "type": "string" } } }, "resolution_status": { "enum": ["RESOLVED","UNRESOLVED"] } } } },
    "invented_fields_detected": { "type": "array", "items": { "type": "string" }, "description": "fields in the extractor output that are not supported by the source" },
    "counterevidence_status": { "enum": ["NOT_FOUND_IN_SOURCE","CAVEATS_FOUND","FAILURE_EXAMPLES_FOUND","CONTRADICTIONS_FOUND"] },
    "executable_assessment": { "enum": ["EXECUTABLE","SPEC_INCOMPLETE","NOT_EXECUTABLE","LEAD_ONLY"] },
    "missing_source_support": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
