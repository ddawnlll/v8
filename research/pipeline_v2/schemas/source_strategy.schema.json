{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source Strategy",
  "description": "research_pipeline_v2.0 book_synthesizer output. Single-book native strategy definition; NOT crypto-adapted.",
  "type": "object",
  "required": ["source_strategy_id", "book_id", "supporting_claim_ids", "source_name", "source_status", "source_native_spec", "source_unknowns"],
  "properties": {
    "source_strategy_id": { "type": "string" },
    "book_id": { "type": "string" },
    "supporting_claim_ids": { "type": "array", "items": { "type": "string" } },
    "source_name": { "type": "string" },
    "source_status": { "enum": ["EXECUTABLE_COMPLETE","EXECUTABLE_BUT_INCOMPLETE","SPEC_INCOMPLETE","CONCEPTUAL_ONLY","LEAD_ONLY"] },
    "source_native_spec": {
      "type": "object",
      "properties": {
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "setup": { "type": "array", "items": { "type": "string" } },
        "trigger": { "type": "array", "items": { "type": "string" } },
        "direction": { "type": "string" },
        "entry": { "type": ["string", "null"] },
        "invalidation": { "type": "array", "items": { "type": "string" } },
        "exit": { "type": ["string", "null"] },
        "stop": { "type": ["string", "null"] },
        "target": { "type": ["string", "null"] }
      }
    },
    "source_unknowns": { "type": "array", "items": { "type": "string" } },
    "original_context": { "type": "object", "properties": { "asset_class": { "type": "string" }, "timeframe": { "type": ["string", "null"] } } },
    "counterevidence_status": { "enum": ["NOT_FOUND_IN_SOURCE","CAVEATS_FOUND","FAILURE_EXAMPLES_FOUND","CONTRADICTIONS_FOUND"] },
    "cross_references": { "type": "array", "items": { "type": "object", "properties": { "source_strategy_id": { "type": "string" }, "relationship": { "enum": ["EXACT_DUPLICATE","CORROBORATES","REFINES","SPECIALIZES","GENERALIZES","CONTRADICTS","SIMILAR_MECHANISM","DIFFERENT_BEHAVIOR"] } } } }
  },
  "additionalProperties": false
}
