{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Raw Source Claim",
  "description": "research_pipeline_v2.0 faithful_extractor output. Source-only knowledge: NO crypto/V8 interpretation may appear in non-quote fields.",
  "type": "object",
  "required": ["raw_claim_id", "lead_id", "book_id", "edition_id", "source", "supporting_passages", "claim_type", "source_rule", "unknowns"],
  "properties": {
    "raw_claim_id": { "type": "string", "pattern": "^claim_[a-z0-9_]+_\\d+_\\d+$" },
    "lead_id": { "type": "string" },
    "book_id": { "type": "string" },
    "edition_id": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["page_start", "page_end", "chapter"],
      "properties": {
        "page_start": { "type": ["integer", "null"] },
        "page_end": { "type": ["integer", "null"] },
        "chapter": { "type": "string" },
        "part_id": { "type": "string" },
        "figure_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "supporting_passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["exact_text"],
        "properties": {
          "page": { "type": ["integer", "null"] },
          "exact_text": { "type": "string", "minLength": 10 },
          "is_ocr": { "type": "boolean", "default": false }
        }
      }
    },
    "claim_type": { "enum": ["EXECUTABLE_STRATEGY_RULE","SETUP_DEFINITION","TRIGGER_RULE","INVALIDATION_RULE","EXIT_RULE","RISK_RULE","POSITION_SIZING","REGIME_RULE","FEATURE_CLAIM","EMPIRICAL_CLAIM","FAILURE_CLAIM","METHODOLOGY_CLAIM","PSYCHOLOGY_CLAIM","AUTHOR_CAVEAT","CONCEPT_DEFINITION","LEAD_ONLY"] },
    "original_context": {
      "type": "object",
      "properties": {
        "asset_class": { "enum": ["equities","futures","forex","commodities","options","crypto","multiple","NOT_SPECIFIED"] },
        "instrument": { "type": "string" },
        "timeframe": { "type": ["string", "null"], "description": "as stated by the author; NOT_SPECIFIED if absent" },
        "session_model": { "enum": ["exchange_session","24_7","NOT_SPECIFIED"] }
      }
    },
    "source_rule": {
      "type": "object",
      "description": "only what the source states; anything absent is NOT_SPECIFIED and repeated in unknowns",
      "properties": {
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "setup": { "type": "array", "items": { "type": "string" } },
        "trigger": { "type": "array", "items": { "type": "string" } },
        "direction": { "enum": ["LONG","SHORT","BOTH","OPPOSITE_BREAKOUT","OPPOSITE_BREACH","NOT_SPECIFIED"] },
        "entry": { "enum": ["SOURCE_SPECIFIED","NOT_SPECIFIED"] },
        "entry_detail": { "type": "string" },
        "invalidation": { "type": "array", "items": { "type": "string" } },
        "exit": { "enum": ["SOURCE_SPECIFIED","NOT_SPECIFIED"] },
        "exit_detail": { "type": "string" },
        "stop": { "enum": ["SOURCE_SPECIFIED","NOT_SPECIFIED"] },
        "stop_detail": { "type": "string" },
        "target": { "enum": ["SOURCE_SPECIFIED","NOT_SPECIFIED"] },
        "target_detail": { "type": "string" },
        "holding_period": { "enum": ["SOURCE_SPECIFIED","NOT_SPECIFIED"] },
        "holding_period_detail": { "type": "string" }
      }
    },
    "author_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "provenance"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": ["string", "number", "null"] },
          "unit": { "type": "string" },
          "provenance": { "enum": ["SOURCE_EXPLICIT","SOURCE_DERIVED","UNRESOLVED"] }
        }
      }
    },
    "author_caveats": { "type": "array", "items": { "type": "object", "properties": { "page": { "type": ["integer", "null"] }, "exact_text": { "type": "string" }, "meaning": { "type": "string" } } } },
    "failure_examples": { "type": "array", "items": { "type": "object", "properties": { "page": { "type": ["integer", "null"] }, "summary": { "type": "string" } } } },
    "empirical_details": {
      "type": ["object", "null"],
      "description": "quantitative claims kept separate; see quantitative_claim",
      "properties": { "present": { "type": "boolean", "default": false } }
    },
    "quantitative_claim": {
      "type": ["object", "null"],
      "properties": {
        "metric": { "type": "string" },
        "value": { "type": ["number", "string", "null"] },
        "sample_size": { "enum": ["NOT_REPORTED"] },
        "period": { "type": ["string", "null"] },
        "costs_included": { "enum": ["NOT_REPORTED","true","false"] },
        "evidence_grade": { "enum": ["E0","E1","E2","E3","E4","E5","E6","E7"] },
        "claim_status": { "enum": ["SUBSTANTIATED","UNSUBSTANTIATED"] }
      }
    },
    "unknowns": { "type": "array", "items": { "type": "string" }, "description": "every field the source does not specify, e.g. stop, target, position_size, exact_reentry_window" },
    "provenance_notes": { "type": "object", "description": "field -> provenance label for fields that are derived or resolved", "additionalProperties": { "enum": ["SOURCE_EXPLICIT","SOURCE_DERIVED","UNRESOLVED"] } }
  },
  "additionalProperties": false
}
