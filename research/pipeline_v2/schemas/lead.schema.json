{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claim Scout Lead",
  "description": "research_pipeline_v2.0 claim_scout output. A lead marks a candidate passage; it is NOT a claim and contains no extraction.",
  "type": "object",
  "required": ["lead_id", "book_id", "part_id", "claim_type_candidates", "anchor_text", "local_start_line", "local_end_line", "reason"],
  "properties": {
    "lead_id": { "type": "string", "pattern": "^lead_[a-z0-9_]+_\\d+$" },
    "book_id": { "type": "string", "pattern": "^book_\\d{4}$" },
    "part_id": { "type": "string" },
    "claim_type_candidates": { "type": "array", "items": { "enum": ["STRATEGY_SETUP","TRIGGER_RULE","ENTRY_RULE","INVALIDATION_RULE","EXIT_RULE","POSITION_SIZING","REGIME_FILTER","LIFECYCLE_RULE","PORTFOLIO_RISK_RULE","FEATURE_CLAIM","EMPIRICAL_CLAIM","FAILURE_EXAMPLE","AUTHOR_CAVEAT","METHODOLOGY_RULE"] } },
    "anchor_text": { "type": "string", "minLength": 20, "description": "verbatim passage from the source" },
    "local_start_line": { "type": "integer" },
    "local_end_line": { "type": "integer" },
    "context_before": { "type": "string", "description": "tail of previous part / preceding paragraph, verbatim" },
    "context_after": { "type": "string", "description": "head of next part / following paragraph, verbatim" },
    "reason": { "type": "string" },
    "priority": { "enum": ["high", "medium", "low"] },
    "needs_previous_context": { "type": "boolean", "default": false },
    "needs_next_context": { "type": "boolean", "default": false },
    "index_only": { "type": "boolean", "description": "true if the lead came from an index/TOC entry; such leads may only point to a page, never become a claim directly", "default": false },
    "legacy_hint_ids": { "type": "array", "items": { "type": "string" }, "description": "v1 legacy record ids used only as recall hints" }
  },
  "additionalProperties": false
}
