# Agent/editor state
.mimocode/
.playwright-mcp/
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/
build/

# Local run stores (lab output dirs)
*.jsonl
!research/manifest/*.json
!docs/governance/*.jsonl

# Downloaded tape (derived from public archives, reproducible)
research/tape/

# Scratch build/experiment outputs (Lab stores, regret cubes, one-off
# comparison scripts) — reproducible from tools/*.py against the tracked
# tape/code; never a durable artifact.
tmp/

# Downloaded papers (derived from public archives; research/manifest tracks
# them, tools/download_v8_reading_list.py re-fetches)
research/papers/

# Handbook extraction source PDF + derived working dir (reproducible via
# tools/extract_handbook_*.py; review reports live in the books submodule)
/The Handbook of Technical Analysis - The Practitioner's Comprehensive Guide to Technical Analysis 2016.pdf
research/handbook_technical_analysis_2016/

# Raw process logs (reproducible; report artifacts stay tracked)
.audit/*.log
# Ephemeral audit process outputs (governance reset 2026-09-07):
# logs, normalized diffs, captured stdout/stderr and sidecar hashes are
# local/CI artifacts. Repo keeps only canonical release evidence manifests
# and release-persistent evidence (receipts, seals, manifests).
.audit/**/*.log
.audit/**/*.norm
.audit/**/*.stdout
.audit/**/*.stderr
.audit/**/*.sha256
# Giant generated oracle-coverage dumps (2026-09-08 consolidation: ~950k lines,
# reproducible from the tracked tape via the oracle-coverage binary; kept on disk,
# never tracked).
.audit/history/20260819_094539_post-kaizen-kz001-kz005/request_oracle_coverage.json
.audit/history/20260819_094539_post-kaizen-kz001-kz005/oracle_coverage_receipt.json
.audit_archive_python_base/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Hermes Kanban worktrees
.worktrees/
