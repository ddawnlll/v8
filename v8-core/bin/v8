#!/usr/bin/env python3
"""D-153 Benchmark Suite Runner - Single command entry point."""
import subprocess
import sys


def main():
    """Run full D-153 benchmark suite."""
    result = subprocess.run(
        ["cargo", "run", "--quiet", "--bin", "v8-core", "--", "bench"],
        cwd=".",
        check=False
    )
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()